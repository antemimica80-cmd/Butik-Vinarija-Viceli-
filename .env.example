# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics — Plausible (cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Booking & shop — Stripe TEST mode keys. Leave as-is to run in demo-payment mode.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Postgres (e.g. Neon via Vercel Marketplace). Leave as-is locally: an embedded
# Postgres (PGlite) is stored in .data/pglite. PGLITE_DIR=memory keeps it in RAM.
DATABASE_URL=postgres://...
# PGLITE_DIR=.data/pglite

# Transactional email (Resend). Without a key, emails are written to .data/outbox/.
RESEND_API_KEY=re_...
EMAIL_FROM="Vicelić <bookings@example.com>"
# Where booking / enquiry notifications go. Never defaults to the estate's real address.
WINERY_NOTIFY_EMAIL=

# /admin (user "admin"). Admin is disabled while empty.
ADMIN_PASSWORD=
