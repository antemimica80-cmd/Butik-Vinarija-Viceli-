# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics — Plausible (cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Stage 4+ (booking & shop) — Stripe TEST mode keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stage 4+ — Postgres (e.g. Neon via Vercel Marketplace)
DATABASE_URL=postgres://...

# Stage 4+ — Transactional email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Vicelić <bookings@example.com>"
WINERY_NOTIFY_EMAIL=

# Stage 4+ — /admin password
ADMIN_PASSWORD=
