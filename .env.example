# --- Database (PostgreSQL 15+ with PostGIS, pg_trgm, unaccent, pgcrypto) ---
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
# Set to false when connecting through a transaction-mode pooler (e.g. Supabase pgbouncer :6543)
DATABASE_PREPARE=true

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string used to sign form tokens and hash IPs (openssl rand -hex 32)
APP_SECRET=change-me-to-a-long-random-string

# --- Map ---
# Any MapLibre style URL. Default: OpenFreeMap "positron" (OpenStreetMap data, no API key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Optional routing provider for the wine route planner (OSRM-compatible HTTP API).
# Leave empty to disable driving times (the planner never shows straight-line estimates).
ROUTING_OSRM_URL=

# --- Email (Resend). Without a key, emails are stored in the outbox with status "no_provider". ---
RESEND_API_KEY=
EMAIL_FROM="Croatian Wine Atlas <no-reply@example.com>"
# Where copies of inquiries for wineries without a public email are sent (editorial desk)
EDITORIAL_EMAIL=

# --- Uploads ---
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=8

# --- Tests: separate database rebuilt by `npm test` (never point at production) ---
TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_test
